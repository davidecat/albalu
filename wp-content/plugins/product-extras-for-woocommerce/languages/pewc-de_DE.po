#: templates/admin/sections/swatches.php:42
msgid "Replace main image"
msgstr "Hauptbild ersetzen"

#: admin/functions-admin-settings.php:592
msgid "Enable this option to replace the main product image with the selected image swatch."
msgstr "Aktivieren Sie diese Option, um das Hauptproduktbild durch das ausgewählte Bildmuster zu ersetzen."

#: admin/functions-admin-settings.php:727
msgid "Show stock status"
msgstr "Lagerbestand anzeigen"

#: admin/functions-admin-settings.php:730
msgid "Enable this to add a child product's stock status to their name"
msgstr "Aktivieren Sie dies, um den Lagerbestand eines untergeordneten Produkts zu dessen Namen hinzuzufügen"

#: admin/functions-admin-settings.php:746
msgid "Enable plus minus buttons"
msgstr "Plus-Minus-Schaltflächen aktivieren"

#: admin/functions-admin-settings.php:749
msgid "Enable this to show + and - buttons alongside quantity fields in Products fields."
msgstr "Aktivieren Sie dies, um neben den Mengenfeldern in Produktfeldern Plus- und Minus-Schaltflächen anzuzeigen."

#: admin/functions-admin-settings.php:759
msgid "QuickView"
msgstr "QuickView"

#: admin/functions-admin-settings.php:774
msgid "New tab"
msgstr "Neuer Tab"

#: admin/functions-admin-settings.php:778
msgid "Optional link text"
msgstr "Optionaler Linktext"

#: admin/functions-admin-settings.php:781
msgid "Enter text here to display as a separate link below the product name. Leave this empty to link directly from the product name."
msgstr "Geben Sie hier Text ein, der als separater Link unter dem Produktnamen angezeigt wird. Lassen Sie dieses Feld leer, um direkt vom Produktnamen aus zu verlinken."

#: admin/functions-admin-settings.php:908
msgid "Enable compatibility with Polylang"
msgstr "Kompatibilität mit Polylang aktivieren"

#: admin/functions-admin-settings.php:911
msgid "Enable this only if you have Polylang installed. Also, if you have added the Polylang compatibility snippets before, please remove them before enabling this setting."
msgstr "Aktivieren Sie dies nur, wenn Sie Polylang installiert haben. Wenn Sie zuvor die Polylang-Kompatibilitäts-Snippets hinzugefügt haben, entfernen Sie diese bitte, bevor Sie diese Einstellung aktivieren."

#: admin/functions-admin-settings.php:926
msgid "Dynamic Pricing and Discount Rules"
msgstr "Dynamic Pricing and Discount Rules"

#: admin/functions-admin-settings.php:932
msgid "Disable Dynamic Pricing and Discount Rules price labels"
msgstr "Preisbezeichnungen von Dynamic Pricing and Discount Rules deaktivieren"

#: admin/functions-admin-settings.php:935
msgid "Prevent Dynamic Pricing and Discount Rules from updating the price labels on the product page."
msgstr "Verhindern, dass Dynamic Pricing and Discount Rules die Preisbezeichnungen auf der Produktseite aktualisiert."

#: admin/functions-admin-settings.php:941
msgid "Disable add-on prices on pricing table"
msgstr "Add-On-Preise in der Preistabelle deaktivieren"

#: admin/functions-admin-settings.php:944
msgid "Prevent Add-Ons Ultimate from adding add-on field prices to the pricing table on the product page."
msgstr "Verhindern, dass Add-Ons Ultimate Add-On-Feldpreise zur Preistabelle auf der Produktseite hinzufügt."

#: admin/functions-admin-settings.php:953
msgid "Adjust add-on field prices if User Role Pricing is enabled in Dynamic Pricing and Discount Rules."
msgstr "Add-On-Feldpreise anpassen, wenn rollenbasierte Preise in Dynamic Pricing and Discount Rules aktiviert sind."

#: admin/functions-admin-settings.php:959
msgid "Disable discounts for add-ons"
msgstr "Rabatte für Add-Ons deaktivieren"

#: admin/functions-admin-settings.php:962
msgid "Select this if you don't wish to apply dynamic discounts to add-on field prices."
msgstr "Wählen Sie dies, wenn Sie keine dynamischen Rabatte auf Add-On-Feldpreise anwenden möchten."

#: admin/functions-admin-settings.php:977
msgid "Custom user fields"
msgstr "Benutzerdefinierte Benutzerfelder"

#: admin/functions-admin-settings.php:983
msgid "Enable user fields"
msgstr "Benutzerfelder aktivieren"

#: admin/functions-admin-settings.php:986
msgid "Select this to use custom user data in your add-on fields."
msgstr "Wählen Sie dies, um benutzerdefinierte Benutzerdaten in Ihren Add-On-Feldern zu verwenden."

