msgid "The max file size for uploads (in MB)"
msgstr "Le dimensioni massime del file da caricare (in MB)"

#: admin/functions-admin-settings.php:484
msgid "Enable PDF uploads"
msgstr "Abilita il caricamento di PDF"

#: admin/functions-admin-settings.php:487
msgid "Allow users to upload PDFs."
msgstr "Consenti agli utenti di caricare file PDF."

#: admin/functions-admin-settings.php:492
msgid "Enable AJAX uploader"
msgstr "Abilita il caricamento via AJAX"

#: admin/functions-admin-settings.php:495
