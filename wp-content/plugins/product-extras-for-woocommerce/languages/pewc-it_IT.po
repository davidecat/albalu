msgid "Rename uploads"
msgstr "Rinomina i file caricati"

#: admin/functions-admin-settings.php:530
msgid "Rename uploads using the following tags: {original_file_name}, {order_number}, {date}, {product_id}, {product_sku}, {group_id}, {field_id}"
msgstr "Rinomina i file caricati utilizzando i seguenti tag: {original_file_name}, {order_number}, {date}, {product_id}, {product_sku}, {group_id}, {field_id}"

